# ---------------------------------------------------------------------------
# Universal Casino Game Engine — example environment file
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
# In production, set these as real environment variables instead of using a
# file, wherever the hosting environment allows it.
#
# VIRTUAL CREDITS ONLY. No real-money configuration exists or is needed.
# ---------------------------------------------------------------------------

# Application
APP_NAME="Universal Casino Game Engine"
APP_ENV=development          # development | testing | production
APP_DEBUG=true               # never true in production
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en

# Engine
ENGINE_CURRENCY=PHP
# Leave empty to use the engine's own version.
ENGINE_VERSION_OVERRIDE=

# Logging: debug | info | notice | warning | error | critical
LOG_LEVEL=debug
LOG_CHANNEL=file             # file | stdout | null
LOG_PATH=storage/logs

# Database (development fallback). On the deployed htdocs bundle the preferred
# location is config/database.local.php; real credentials never go in Git.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=casino_engine
DB_USERNAME=engine
DB_PASSWORD=change_me
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ATTR_PERSISTENT=false
DB_ATTR_EMULATE_PREPARES=false

# Test database (used by the integration test suite)
DB_TEST_DATABASE=casino_engine_test

# Session
SESSION_TTL_SECONDS=3600
SESSION_IDLE_TTL_SECONDS=1800

# Game discovery: comma-separated namespaces scanned for game modules.
GAME_DISCOVERY_NAMESPACES="CasinoEngine\\Games"

# Betting defaults (minor units; 100 = PHP 1.00)
DEFAULT_CURRENCY_MINOR_UNITS=2
MIN_BET_MINOR=100
MAX_BET_MINOR=1000000

# Security
PASSWORD_ALGO=argon2id        # argon2id | bcrypt
API_TOKEN_TTL_SECONDS=86400
API_RATE_LIMIT_PER_MINUTE=120
API_MAX_BODY_BYTES=65536
IDEMPOTENCY_TTL_SECONDS=86400
AUDIT_RETENTION_DAYS=90
RATE_LIMIT_RETENTION_DAYS=7

# Self-service registration (virtual credits only; no payment step exists)
ALLOW_SELF_REGISTRATION=true
# Starting balance in minor units: 30000 = exactly 300.00 credits, granted once.
REGISTRATION_STARTING_BALANCE_MINOR=30000
