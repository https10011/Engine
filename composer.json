{
    "name": "casino/universal-game-engine",
    "description": "A reusable, modular PHP game engine for casino-style games (slots, card games, roulette) using simulated virtual credits only.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "suggest": {
        "ext-openssl": "Stronger entropy for secure random generation (recommended in production)"
    },
    "autoload": {
        "psr-4": {
            "CasinoEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CasinoEngine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src tests bin public -name '*.php' -print0 | xargs -0 -n1 php -l",
        "cs": "phpcs --standard=phpcs.xml.dist",
        "cs:fix": "phpcbf --standard=phpcs.xml.dist",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
