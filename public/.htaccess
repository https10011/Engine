# Front controller rewrite for Apache shared hosting.
#
# The intended deployment is that the web server's document root *is* this
# directory, so `src/`, `config/`, `database/`, `storage/` and `tests/` are
# above it and unreachable over HTTP. This file makes routing work for that
# layout: a request for a real file (CSS, JS, images the future frontend will
# add) is served, and anything else is handed to the front controller.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Honour the Authorization header, which some CGI/FastCGI setups strip.
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Never list a directory's contents.
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
</IfModule>

# Deny dotfiles outright.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
